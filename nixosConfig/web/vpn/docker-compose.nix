{
  config,
  pkgs,
  lib,
  ...
}: {
  # options.my.windows = lib.mkEnableOption "windwos vpn";
  # config = lib.mkIf config.my.windows {
  my.docker = true;

  # Auto-generated by compose2nix.

  # Runtime
  virtualisation.docker = {
    enable = true;
    autoPrune.enable = true;
  };
  virtualisation.oci-containers.backend = "docker";

  # Containers
  virtualisation.oci-containers.containers."windows_vpn" = {
    image = "dockurr/windows:latest";
    entrypoint = "/usr/bin/tini";
    cmd = [
      "-s"
      "--"
      "/bin/bash"
      "-c"
      ''
        set -euo pipefail
        grep -F '( sleep 30; boot ) &' /run/entry.sh
        sed -i 's/( sleep 30; boot ) \&/( sleep 180; boot ) \&/' /run/entry.sh
        exec /run/entry.sh
      ''
    ];
    environment = {
      "VERSION" = "10";
      "CPU_CORES" = "4";
      "RAM_SIZE" = "8G";
    };
    volumes = [
      "/data/windows:/storage:rw"
    ];
    log-driver = "journald";
    extraOptions = [
      "--cap-add=NET_ADMIN"
      "--device=/dev/kvm:/dev/kvm:rwm"
      "--device=/dev/net/tun:/dev/net/tun:rwm"
      "--ip=172.30.0.2"
      "--network-alias=container"
      "--network=windows_vpn_net"
      "--stop-timeout=120"
    ];
  };
  systemd.services."docker-windows_vpn" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    after = [
      "docker-network-windows_vpn_net.service"
    ];
    requires = [
      "docker-network-windows_vpn_net.service"
    ];
    partOf = [
      "docker-compose-windows_vpn-root.target"
    ];
    wantedBy = [
      "docker-compose-windows_vpn-root.target"
    ];
  };

  # Networks
  systemd.services."docker-network-windows_vpn_net" = {
    path = [pkgs.docker];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "docker network rm -f windows_vpn_net";
    };
    script = ''
      docker network inspect windows_vpn_net || docker network create windows_vpn_net --driver=bridge --subnet=172.30.0.0/24
    '';
    partOf = ["docker-compose-windows_vpn-root.target"];
    wantedBy = ["docker-compose-windows_vpn-root.target"];
  };

  # Send traffic addressed to the Dockurr container to its nested Windows guest.
  systemd.services."windows-vpn-forward" = {
    description = "Forward Dockurr traffic to the nested Windows VM";
    after = ["docker-windows_vpn.service"];
    requires = ["docker-windows_vpn.service"];
    before = ["windows-vpn-ready.service"];
    path = [pkgs.docker];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      for attempt in $(seq 1 60); do
        if docker inspect windows_vpn >/dev/null 2>&1; then
          break
        fi
        sleep 1
      done
      docker inspect windows_vpn >/dev/null
      docker exec windows_vpn iptables -t nat -C PREROUTING \
        -d 172.30.0.2 -j DNAT --to-destination 172.31.0.2 \
        || docker exec windows_vpn iptables -t nat -A PREROUTING \
          -d 172.30.0.2 -j DNAT --to-destination 172.31.0.2
    '';
    partOf = ["docker-compose-windows_vpn-root.target"];
    wantedBy = ["docker-compose-windows_vpn-root.target"];
  };

  systemd.services."windows-vpn-gateway" = {
    description = "Configure the Dockurr guest gateway for Windows";
    after = ["docker-windows_vpn.service"];
    requires = ["docker-windows_vpn.service"];
    before = ["windows-vpn-ready.service"];
    path = [
      pkgs.coreutils
      pkgs.docker
    ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      for attempt in $(seq 1 60); do
        if docker inspect windows_vpn >/dev/null 2>&1; then
          break
        fi
        sleep 1
      done
      docker inspect windows_vpn >/dev/null
      docker exec windows_vpn sh -eu -c '
        for attempt in $(seq 1 60); do
          guest_iface="$(ip -o -4 addr show | awk '"'"'$4 == "172.31.0.1/24" {print $2; exit}'"'"')"
          if [ -n "$guest_iface" ]; then
            break
          fi
          sleep 1
        done
        wan_iface="$(ip route show default | awk '"'"'{print $5; exit}'"'"')"
        test -n "$guest_iface"
        test -n "$wan_iface"
        ip addr replace 10.10.0.1/24 dev "$guest_iface"
        if [ "$(cat /proc/sys/net/ipv4/ip_forward)" != 1 ]; then
          sysctl -w net.ipv4.ip_forward=1
        fi
        test "$(cat /proc/sys/net/ipv4/ip_forward)" = 1
        iptables -t nat -C POSTROUTING -s 10.10.0.0/24 -o "$wan_iface" -j MASQUERADE \
          || iptables -t nat -A POSTROUTING -s 10.10.0.0/24 -o "$wan_iface" -j MASQUERADE
      '
    '';
    partOf = ["docker-compose-windows_vpn-root.target"];
    wantedBy = ["docker-compose-windows_vpn-root.target"];
  };

  systemd.services."windows-vpn-route" = {
    description = "Route traffic to the nested Windows VM";
    after = ["docker-network-windows_vpn_net.service"];
    requires = ["docker-network-windows_vpn_net.service"];
    before = ["windows-vpn-ready.service"];
    path = [pkgs.iproute2];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStop = "${pkgs.writeShellScript "windows-vpn-route-down" ''
        ip route del 10.10.0.0/24 via 172.30.0.2 || true
        ip route del 172.31.0.0/24 via 172.30.0.2 || true
      ''}";
    };
    script = ''
      ip route replace 10.10.0.0/24 via 172.30.0.2
      ip route replace 172.31.0.0/24 via 172.30.0.2
    '';
    partOf = ["docker-compose-windows_vpn-root.target"];
    wantedBy = ["docker-compose-windows_vpn-root.target"];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-windows_vpn-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    # wantedBy = ["jellyfin-root.target"];
    # partOf = ["jellyfin-root.target"];

    wantedBy = ["multi-user.target"];
  };

  # Wait until Windows is actually reachable through both advertised services.
  systemd.services."windows-vpn-ready" = {
    description = "Wait for Windows VPN VM to become ready";
    after = [
      "docker-windows_vpn.service"
      "windows-vpn-gateway.service"
      "windows-vpn-route.service"
    ];
    requires = [
      "docker-windows_vpn.service"
      "windows-vpn-gateway.service"
      "windows-vpn-route.service"
    ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    path = [pkgs.netcat];
    script = ''
      until { nc -z -w 2 10.10.0.2 22 && nc -z -w 2 10.10.0.2 3389; } \
        || { nc -z -w 2 172.30.0.2 22 && nc -z -w 2 172.30.0.2 3389; }; do
        sleep 2
      done
    '';
    partOf = ["docker-compose-windows_vpn-root.target"];
    wantedBy = ["docker-compose-windows_vpn-root.target"];
  };
  # };
}
