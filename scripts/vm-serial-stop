#!/usr/bin/env bash
set -euo pipefail

state_dir=${VM_SERIAL_STATE_DIR:-/tmp/nixos-vm-console}

for service in socat qemu; do
  pid_file=$state_dir/$service.pid
  if [[ -f $pid_file ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
    kill -TERM "$(<"$pid_file")"
  fi
done

echo "VM serial-console processes stopped. State remains in $state_dir."
