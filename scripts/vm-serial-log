#!/usr/bin/env bash
set -euo pipefail

state_dir=${VM_SERIAL_STATE_DIR:-/tmp/nixos-vm-console}
log=$state_dir/serial.log

if [[ ! -f $log ]]; then
  echo "No serial log. Start the VM with scripts/vm-serial-start." >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  tail -n 80 "$log"
else
  tail "$@" "$log"
fi
